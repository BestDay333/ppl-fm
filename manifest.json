{
  "manifest_version": 3,
  "name": "PPL FM Tab for PepeLand",
  "version": "1.4",
  "description": "Медиацентр PPL FM для PepeLand с локальной загрузкой интерфейса",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.pepeland.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["player.html", "news.json", "ppl-only-logo-dark.png"],
      "matches": ["https://*.pepeland.net/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.pepeland.net/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}